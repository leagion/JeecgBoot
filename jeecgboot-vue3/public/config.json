{
  "title": "数智一体化平台",
  "env": {
    "VITE_PORT": 3000,
    "VITE_GLOB_APP_TITLE": "数智一体化平台",
    "VITE_GLOB_APP_SHORT_NAME": "数智一体化平台",
    "VITE_GLOB_APP_CAS_BASE_URL": "http://cas.test.com:8443/cas",
    "VITE_GLOB_APP_OPEN_SSO": false,
    "VITE_GLOB_APP_OPEN_QIANKUN": true,
    "VITE_GLOB_ONLINE_VIEW_URL": "http://fileview.jeecg.com/onlinePreview",
    "VITE_GLOB_DOMAIN_URL": "${VITE_GLOB_DOMAIN_URL:-http://localhost:8080/aiccg}",
    "VITE_GLOB_API_URL": "${VITE_GLOB_API_URL:-/aiccg}",
    "VITE_GLOB_API_URL_PREFIX": "${VITE_GLOB_API_URL_PREFIX:-}",
    "VITE_PUBLIC_PATH": "${VITE_PUBLIC_PATH:-/}"
  },
  "server": {
    "port": 3000,
    "host": "0.0.0.0"
  },
  "wms": {
    "url": "${WMS_URL:-http://localhost:8080/geoserver/aiccgmap/wms}",
    "layers": "${WMS_LAYERS:-aiccgmap:lq_poi_static}",
    "parameters": {
      "transparent": true,
      "format": "image/png"
    },
    "bbox": {
      "west": 109.5999984741211,
      "south": 3.966669797897339,
      "east": 119.31700134277344,
      "north": 20.96670150756836
    }
  },
  "wfs": {
    "url": "${WFS_URL:-http://localhost:8080/geoserver/aiccgmap/ows}",
    "layer": "${WFS_LAYER:-aiccgmap:lq_poi_static}"
  },
  "appId": "1947650682653323265",
  "chatJsUrl": "/chat/chat.js",
  "mapConfig": {
    "imageServer": {
      "ip": "${IMAGE_SERVER_IP:-0.0.0.0}",
      "port": "${IMAGE_SERVER_PORT:-5160}"
    },
    "lineServer": {
      "ip": "${LINE_SERVER_IP:-0.0.0.0}",
      "port": "${LINE_SERVER_PORT:-5160}"
    },
    "geoServer": {
      "ip": "${GEOSERVER_IP:-localhost}",
      "port": "${GEOSERVER_PORT:-8080}",
      "layers": "${GEOSERVER_LAYERS:-ne:coastlines}"
    },
   
    "defaultBaseMap": 2
  },
   "fileservice": {
      "host": "${FILESERVICE_HOST:-localhost}",
      "port": "${FILESERVICE_PORT:-8090}",
      "uploadPath": "${FILESERVICE_UPLOAD_PATH:-/static/upload}"
    }
}