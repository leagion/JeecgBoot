{
  "overlayLayers": [
    {
      "id": "base_layer",
      "name": "基础地理图层",
      "url": "${BASE_LAYER_URL:-http://localhost:8080/geoserver/wms}",
      "layers": "${BASE_LAYER_LAYERS:-nurc:Arc_Sample}",
      "parameters": {
        "service": "WMS",
        "version": "1.1.0",
        "request": "GetMap"
      },
      "alpha": 0.3,
      "visible": true,
      "order": 1
    },
    
    {
      "id": "road_layer",
      "name": "道路图层",
      "url": "${ROAD_LAYER_URL:-http://localhost:8080/geoserver/wms}",
      "layers": "${ROAD_LAYER_LAYERS:-workspace:roads}",
      "parameters": {
        "service": "WMS",
        "version": "1.1.0",
        "request": "GetMap"
      },
      "alpha": 0.8,
      "visible": true,
      "order": 2
    },
    {
      "id": "building_layer",
      "name": "建筑物图层",
      "url": "${BUILDING_LAYER_URL:-http://localhost:8080/geoserver/wms}",
      "layers": "${BUILDING_LAYER_LAYERS:-workspace:buildings}",
      "parameters": {
        "service": "WMS",
        "version": "1.1.0",
        "request": "GetMap"
      },
      "alpha": 0.7,
      "visible": true,
      "order": 3
    },
    {
      "id": "vegetation_layer",
      "name": "植被图层",
      "url": "${VEGETATION_LAYER_URL:-http://localhost:8080/geoserver/wms}",
      "layers": "${VEGETATION_LAYER_LAYERS:-workspace:vegetation}",
      "parameters": {
        "service": "WMS",
        "version": "1.1.0",
        "request": "GetMap"
      },
      "alpha": 0.6,
      "visible": false,
      "order": 4
    },
    {
      "id": "water_layer",
      "name": "水域图层",
      "url": "${WATER_LAYER_URL:-http://localhost:8080/geoserver/wms}",
      "layers": "${WATER_LAYER_LAYERS:-ne:boundary_lines}",
      "parameters": {
        "service": "WMS",
        "version": "1.1.0",
        "request": "GetMap"
      },
      "alpha": 0.9,
      "visible": true,
      "order": 5
    }
  ]
}