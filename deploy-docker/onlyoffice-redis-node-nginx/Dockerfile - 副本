# 使用官方OnlyOffice Document Server镜像作为基础
FROM onlyoffice/documentserver:latest

# 维护者信息
LABEL maintainer="李强"
LABEL description="OnlyOffice Document Server with Chinese fonts and external PostgreSQL support"

# 步骤1：设置环境变量
ENV LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8 \
    TZ=Asia/Shanghai \
    JWT_ENABLED=false \
    DB_HOST=pg18-vector-gis-v1.0 \
    DB_PORT=5432 \
    DB_NAME=onlyoffice \
    DB_USER=oo_user \
    DB_PWD=hkzdlq@CCG2025

# 步骤2：安装语言包（只安装必要的，不安装字体）
RUN apt-get update && \
    apt-get install -y --no-install-recommends locales && \
    # 配置中文locale
    echo "zh_CN.UTF-8 UTF-8" >> /etc/locale.gen && \
    locale-gen zh_CN.UTF-8 && \
    update-locale LANG=zh_CN.UTF-8 && \
    # 清理缓存
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

# 步骤3：复制本地中文字体
COPY fontsCN/ /usr/share/fonts/truetype/

# 步骤4：设置字体权限并更新字体缓存
RUN chmod -R 755 /usr/share/fonts/truetype/ && \
    fc-cache -fv

# 步骤5：复制自定义配置文件
COPY default.json /etc/onlyoffice/documentserver/local.json

# 步骤6：创建必要的目录并设置权限
RUN mkdir -p /var/log/onlyoffice /var/www/onlyoffice/Data /var/www/onlyoffice/Data/certs && \
    chmod -R 755 /var/log/onlyoffice /var/www/onlyoffice/Data

# 步骤7：复制启动脚本并赋予执行权限
COPY start.sh /usr/local/bin/start.sh
RUN chmod +x /usr/local/bin/start.sh

# 暴露端口
EXPOSE 80 443

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost/healthcheck || exit 1

# 使用自定义启动命令
CMD ["/usr/local/bin/start.sh"]